# Zero-copy virtio-vsock I/O over the Device Memory Buffer. Only the 6.18
# patch defines this symbol: it needs the premapped virtqueue add API, which
# upstream added in v6.13, so 5.10 and 6.1 carry the bounce path only.
# rebuild.sh therefore wires this fragment into the 6.18 builds alone.
CONFIG_VIRTIO_DMB_ZEROCOPY=y
